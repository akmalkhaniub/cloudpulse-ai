{
  "name": "cloudpulse-ai",
  "version": "1.0.0",
  "description": "Autonomous Cloud Architecture & Cost Sentinel for Amazon Developer Hackathon",
  "main": "dist/iac_parser.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-public.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run typecheck && tsx test/verify_cloudpulse.ts && tsx test/parser.test.ts && tsx test/eval.test.ts && tsx test/server_integration.ts",
    "test:unit": "tsx test/verify_cloudpulse.ts",
    "test:integration": "tsx test/server_integration.ts",
    "docker:build": "docker build -t cloudpulse-ai:latest .",
    "docker:run": "docker run -d -p 3002:3002 --name cloudpulse-ai cloudpulse-ai:latest",
    "docker:compose": "docker compose up -d",
    "deploy:aws": "sh deploy/aws/deploy.sh",
    "deploy:gcp": "sh deploy/gcp/deploy.sh",
    "deploy:azure": "sh deploy/azure/deploy.sh",
    "deploy:k8s": "kubectl apply -k deploy/k8s/",
    "tunnel": "powershell -ExecutionPolicy Bypass -File deploy/free/tunnel.ps1",
    "test:eval": "tsx test/eval.test.ts",
    "eval": "tsx src/eval.ts",
    "coverage": "c8 sh -c \"tsx test/verify_cloudpulse.ts && tsx test/parser.test.ts && tsx test/eval.test.ts && tsx test/server_integration.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1135.0",
    "dotenv": "^16.4.7"
  },
  "keywords": [
    "aws",
    "cloud",
    "terraform",
    "cdk",
    "well-architected",
    "bedrock",
    "finops",
    "devops"
  ],
  "author": "Antigravity Builder",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "c8": "^10.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
