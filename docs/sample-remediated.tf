# After: all four fixes applied, including the approved database change (with its final-snapshot guard).
# Generated by CloudPulse. Savings use the local us-east-1 price table.
resource "aws_security_group" "web_sg" {
  name        = "web-server-sg"
  description = "Security group with open inbound SSH"

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["10.0.0.0/16"] # TODO: set to your VPN or bastion CIDR
  }
}

resource "aws_db_instance" "app_db" {
  allocated_storage = 100
  engine            = "postgres"
  instance_class    = "db.t3.medium"
  storage_encrypted = true
  kms_key_id        = "alias/aws/rds"
  skip_final_snapshot = false
  final_snapshot_identifier = "app_db-pre-encryption"
  multi_az          = true
  apply_immediately = false
}

resource "aws_instance" "batch_processor" {
  ami           = "ami-0c55b159cbfafe1f0"
  instance_type = "m5.xlarge" # Same x86 family, so the current AMI still boots
}
